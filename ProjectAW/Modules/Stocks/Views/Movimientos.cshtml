@{
	ViewData["Title"] = "Movimientos de stock";
	ViewData["Description"] = "Historial de entradas, salidas y traslados aplicados al inventario.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="page-heading">
	<div>
		<h1>@ViewData["Title"]</h1>
		<p>@ViewData["Description"]</p>
	</div>
	<a class="btn btn-outline-primary" asp-controller="Stock" asp-action="Index">Ver existencias</a>
</section>

<section class="stock-panel" aria-label="Historial de movimientos">
	<div class="stock-toolbar stock-toolbar--filters">
		<label class="stock-filter form-label">Operación <select class="form-select" id="movement-operation-filter"><option value="">Todas</option><option value="1">Entrada</option><option value="2">Salida</option></select></label>
		<label class="stock-filter form-label">Almacén <select class="form-select" id="movement-warehouse-filter"><option value="">Todos</option></select></label>
	</div>
	<div class="stock-alert" id="movement-alert" role="status" aria-live="polite" hidden></div>
	<div class="table-responsive p-3">
		<table class="table align-middle mb-0" id="movement-table">
			<thead><tr><th>Guía</th><th>Motivo</th><th>Operación</th><th>CodProducto</th><th>Producto (dsc)</th><th>Origen</th><th>Destino</th><th>Cantidad esperada</th><th>Cantidad enviada</th><th>Diferencia</th><th>Operador</th><th>Observación</th><th>Fecha - Hora</th></tr></thead>
			<tbody></tbody>
		</table>
	</div>
</section>

@section Styles {
	<link rel="stylesheet" href="~/libs/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/modules/stocks/stocks.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/libs/datatables/dataTables.min.js" asp-append-version="true"></script>
	<script src="~/js/modules/stocks/movimientos.js" asp-append-version="true"></script>
}
