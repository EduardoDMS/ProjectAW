@{
	ViewData["Title"] = "Movimientos de stock";
	ViewData["Description"] = "Historial de entradas, salidas y traslados aplicados al inventario.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
	<div>
		<h1>
			@ViewData["Title"]
		</h1>
		<p class="mb-0">
			@ViewData["Description"]
		</p>
	</div>
	<a class="btn btn-outline-primary" asp-controller="Stock" asp-action="Index">
		Ver existencias
	</a>
</section>

<section class="card" aria-label="Historial de movimientos">
	<div class="card-body">
		<div class="row g-3 align-items-end mb-3">
			<div class="col-12 col-md-4">
				<label class="form-label" for="movement-operation-filter">
					Operación
				</label>
				<select class="form-select" id="movement-operation-filter">
					<option value="">
						Todas
					</option>
					<option value="1">
						Entrada
					</option>
					<option value="2">
						Salida
					</option>
				</select>
			</div>
			<div class="col-12 col-md-4">
				<label class="form-label" for="movement-warehouse-filter">
					Almacén
				</label>
				<select class="form-select" id="movement-warehouse-filter">
					<option value="">
						Todos
					</option>
				</select>
			</div>
		</div>
		<div class="alert alert-danger" id="movement-alert" role="status" aria-live="polite" hidden>
		</div>
		<div class="table-responsive">
			<table class="table table-striped align-middle mb-0" id="movement-table">
				<thead>
					<tr>
						<th scope="col">
							Guía
						</th>
						<th scope="col">
							Motivo
						</th>
						<th scope="col">
							Operación
						</th>
						<th scope="col">
							CodProducto
						</th>
						<th scope="col">
							Producto (dsc)
						</th>
						<th scope="col">
							Origen
						</th>
						<th scope="col">
							Destino
						</th>
						<th scope="col">
							Cantidad esperada
						</th>
						<th scope="col">
							Cantidad enviada
						</th>
						<th scope="col">
							Diferencia
						</th>
						<th scope="col">
							Operador
						</th>
						<th scope="col">
							Observación
						</th>
						<th scope="col">
							Fecha - Hora
						</th>
					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>
		</div>
	</div>
</section>

@section Styles {
	<link rel="stylesheet" href="~/libs/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/modules/stocks/stocks.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/libs/datatables/dataTables.min.js" asp-append-version="true">
	</script>
	<script src="~/js/modules/stocks/movimientos.js" asp-append-version="true">
	</script>
}
