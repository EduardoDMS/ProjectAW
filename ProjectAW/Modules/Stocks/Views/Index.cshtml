@{
	ViewData["Title"] = "Existencias";
	ViewData["Description"] = "Consulta las cantidades disponibles por almacén y producto.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
	<div>
		<h1>
			@ViewData["Title"]
		</h1>
		<p class="mb-0">
			@ViewData["Description"]
		</p>
	</div>
</section>

<section class="card" aria-label="Existencias por almacén">
	<div class="card-body">
		<div class="row g-3 align-items-end mb-3">
			<div class="col-12 col-md-4">
				<label class="form-label" for="stock-warehouse">
					Almacén
				</label>
				<select class="form-select" id="stock-warehouse">
					<option value="">
						Selecciona un almacén
					</option>
				</select>
			</div>
		</div>
		<div class="alert alert-danger" id="stock-alert" role="status" aria-live="polite" hidden>
		</div>
		<p class="mb-3" id="stock-select-prompt">
			Selecciona un almacén para consultar sus existencias.
		</p>
		<div class="table-responsive" id="stock-results" hidden>
			<table class="table table-striped align-middle mb-0" id="stock-table">
				<thead>
					<tr>
						<th scope="col">
							Código prod
						</th>
						<th scope="col">
							Descripción / nombre prod
						</th>
						<th scope="col">
							Ubicación
						</th>
						<th scope="col" class="text-end">
							Stock
						</th>
						<th scope="col">
							Unidad de medida
						</th>
						<th scope="col">
							Fecha última modificación
						</th>
					</tr>
				</thead>
				<tbody>
				</tbody>
			</table>
		</div>
	</div>
</section>

@section Styles {
	<link rel="stylesheet" href="~/libs/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/modules/stocks/stocks.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/libs/datatables/dataTables.min.js" asp-append-version="true">
	</script>
	<script src="~/js/modules/stocks/stock.js" asp-append-version="true">
	</script>
}
