@{
	ViewData["Title"] = "Motivos de guía";
	ViewData["Description"] = "Define las referencias, almacenes y comportamiento de cada guía.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section id="motives-app">
	<header class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-3 mb-4">
		<div>
			<h1>
			Motivos de guía
			</h1>
			<p class="mb-0">
			Define qué datos pide cada guía y cómo afecta al inventario.
			</p>
		</div>
		<button class="btn btn-primary" id="new-motive" type="button">
			<i class="ti ti-plus" aria-hidden="true">
			</i>
			<span>
			Nuevo motivo
			</span>
		</button>
	</header>

	<section class="card" aria-label="Listado de motivos">
		<div class="card-header d-flex flex-column flex-lg-row justify-content-between gap-3">
			<div class="input-group flex-grow-1">
				<span class="input-group-text" aria-hidden="true"><i class="ti ti-search"></i></span>
				<input id="motive-search" type="search" class="form-control" placeholder="Buscar por nombre o comportamiento" autocomplete="off" aria-label="Buscar motivos" />
			</div>
			<div class="row g-3 flex-grow-1">
				<div class="col-12 col-md-6">
					<label class="form-label" for="motive-operation-filter">
					Operación
					</label>
					<select id="motive-operation-filter" class="form-select">
						<option value="">
						Todas
						</option>
						<option value="1">
						Entrada
						</option>
						<option value="2">
						Salida
						</option>
					</select>
				</div>
				<div class="col-12 col-md-6">
					<label class="form-label" for="motive-status-filter">
					Estado
					</label>
					<select id="motive-status-filter" class="form-select">
						<option value="">
						Todos
						</option>
						<option value="true">
						Activos
						</option>
						<option value="false">
						Inactivos
						</option>
					</select>
				</div>
			</div>
		</div>
		<div id="motives-alert" class="alert alert-danger m-3" role="alert" hidden>
		</div>
		<div class="table-responsive">
			<table id="motives-table" class="table table-striped align-middle mb-0">
				<thead>
					<tr>
						<th scope="col">
						Motivo
						</th>
						<th scope="col">
						Operación
						</th>
						<th scope="col">
						Comportamiento
						</th>
						<th scope="col">
						Datos solicitados
						</th>
						<th scope="col">
						Estado
						</th>
						<th scope="col" class="text-end">
						Acciones
						</th>
					</tr>
				</thead>
				<tbody id="motives-rows">
				</tbody>
			</table>
		</div>
		<footer class="card-footer d-flex flex-column flex-md-row justify-content-between gap-2">
			<span id="motives-count" role="status" aria-live="polite">
			Cargando listado…
			</span>
			<span>
			Los cambios afectan las nuevas guías.
			</span>
		</footer>
	</section>
</section>

<div class="modal fade" id="motive-editor" tabindex="-1" aria-labelledby="motive-title" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
		<div class="modal-content">
			<div class="modal-header">
				<div>
					<h2 class="modal-title" id="motive-title">
					Nuevo motivo
					</h2>
					<p class="mb-0">
					Selecciona la información que deberá completar el operador.
					</p>
				</div>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
				</button>
			</div>
			<form id="motive-form">
				<div class="modal-body">
					<div id="motive-form-alert" class="alert alert-danger" role="alert" hidden>
					</div>
					<div class="row g-3">
						<div class="col-md-6">
							<label for="motive-name" class="form-label">Nombre del motivo <b>*</b></label>
							<input class="form-control" id="motive-name" maxlength="100" required placeholder="Ej. Devolución de cliente" />
						</div>
						<div class="col-md-6">
							<label for="motive-operation" class="form-label">Operación <b>*</b></label>
							<select class="form-select" id="motive-operation">
								<option value="1">
								Entrada
								</option>
								<option value="2">
								Salida
								</option>
							</select>
						</div>
						<div class="col-12">
							<label for="motive-behavior" class="form-label">Comportamiento <b>*</b></label>
							<select class="form-select" id="motive-behavior" required>
							</select>
							<div id="motive-help" class="form-text">
							</div>
						</div>
						<fieldset class="col-12 border rounded p-3">
							<legend class="float-none w-auto px-2">
							Datos que solicitará la guía
							</legend>
							<div class="row row-cols-1 row-cols-md-2 g-3">
								<div class="col">
									<div class="form-check">
										<input type="checkbox" id="motive-provider" class="form-check-input" />
										<label class="form-check-label" for="motive-provider">
										Proveedor
										</label>
									</div>
								</div>
								<div class="col">
									<div class="form-check">
										<input type="checkbox" id="motive-client" class="form-check-input" />
										<label class="form-check-label" for="motive-client">
										Cliente
										</label>
									</div>
								</div>
								<div class="col">
									<div class="form-check">
										<input type="checkbox" id="motive-origin" class="form-check-input" />
										<label class="form-check-label" for="motive-origin">
										Almacén de origen
										</label>
									</div>
								</div>
								<div class="col">
									<div class="form-check">
										<input type="checkbox" id="motive-destination" class="form-check-input" />
										<label class="form-check-label" for="motive-destination">
										Almacén de destino
										</label>
									</div>
								</div>
							</div>
						</fieldset>
						<div class="col-12">
							<div class="form-check form-switch">
								<input type="checkbox" id="motive-active" class="form-check-input" checked />
								<label class="form-check-label" for="motive-active">
								Motivo activo
								</label>
							</div>
							<div class="form-text">
							Se mostrará al registrar nuevas guías.
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button class="btn btn-light" type="button" data-bs-dismiss="modal">
					Cancelar
					</button>
					<button class="btn btn-primary" id="save-motive" type="submit">
						<i class="ti ti-device-floppy" aria-hidden="true">
						</i>
						<span>
						Guardar motivo
						</span>
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Styles {
	<link rel="stylesheet" href="~/libs/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/modules/guias/motivos.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/libs/datatables/dataTables.min.js" asp-append-version="true">
	</script>
	<script src="~/js/modules/guias/motivos.js" asp-append-version="true">
	</script>
}
