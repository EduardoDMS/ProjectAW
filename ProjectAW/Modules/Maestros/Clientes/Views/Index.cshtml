@{
	ViewData["Title"] = "Clientes";
	ViewData["Description"] = "Mantén los datos de clientes disponibles para las guías de salida.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
	<div>
		<h1>
			Clientes
		</h1>
		<p class="mb-0">
			Consulta identificación y datos de contacto de tus clientes.
		</p>
	</div>
	<button class="btn btn-primary" id="new-client" type="button">
		＋ Nuevo cliente
	</button>
</section>

<section class="card overflow-hidden">
	<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 p-3 border-bottom">
		<div class="d-flex flex-column flex-sm-row align-items-sm-center gap-2">
			<label class="form-label mb-0" for="client-status">
				Disponibilidad
			</label>
			<select id="client-status" class="form-select">
				<option value="">
					Todos
				</option>
				<option value="true">
					Activos
				</option>
				<option value="false">
					Inactivos
				</option>
			</select>
		</div>
		<span class="ms-sm-auto" id="client-feedback" role="status" aria-live="polite">
		</span>
	</div>
	<div class="alert alert-danger m-3" id="client-alert" role="alert" hidden>
	</div>
	<div class="table-responsive p-3">
		<table id="clients-table" class="table align-middle w-100">
			<thead>
				<tr>
					<th scope="col">
						Razón social
					</th>
					<th scope="col">
						Documento
					</th>
					<th scope="col">
						Correo
					</th>
					<th scope="col">
						Teléfono
					</th>
					<th scope="col">
						Estado
					</th>
					<th scope="col">
						Acciones
					</th>
				</tr>
			</thead>
			<tbody>
			</tbody>
		</table>
	</div>
</section>

<div class="modal fade" id="client-modal" tabindex="-1" aria-labelledby="client-modal-title" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content">
			<div class="modal-header">
				<h2 class="modal-title" id="client-modal-title">
					Nuevo cliente
				</h2>
				<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar">
				</button>
			</div>
			<form id="client-form">
				<div class="modal-body">
					<div class="alert alert-danger" id="client-form-alert" role="alert" hidden>
					</div>
					<div class="row g-3">
						<div class="col-12 col-md-6">
							<label for="client-business-name" class="form-label">
								Razón social *
							</label>
							<input class="form-control" id="client-business-name" name="razonSocial" maxlength="50" required />
						</div>
						<div class="col-12 col-md-6">
							<label for="client-document-type" class="form-label">
								Tipo de documento *
							</label>
							<select class="form-select" id="client-document-type" name="idTipoDocumento" required>
							</select>
						</div>
						<div class="col-12 col-md-6">
							<label for="client-document-number" class="form-label">
								Número de documento *
							</label>
							<input class="form-control" id="client-document-number" name="numeroDocumento" maxlength="25" required />
						</div>
						<div class="col-12 col-md-6">
							<label for="client-address" class="form-label">
								Dirección *
							</label>
							<input class="form-control" id="client-address" name="direccion" maxlength="50" required />
						</div>
						<div class="col-12 col-md-6">
							<label for="client-email" class="form-label">
								Correo
							</label>
							<input class="form-control" id="client-email" name="correo" type="email" maxlength="50" />
						</div>
						<div class="col-12 col-md-6">
							<label for="client-phone" class="form-label">
								Teléfono
							</label>
							<input class="form-control" id="client-phone" name="telefono" maxlength="50" />
						</div>
						<div class="col-12">
							<div class="form-check">
								<input class="form-check-input" id="client-active" name="activo" type="checkbox" />
								<label for="client-active" class="form-check-label">
									Cliente activo
								</label>
							</div>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button class="btn btn-light" type="button" data-bs-dismiss="modal">
						Cancelar
					</button>
					<button class="btn btn-primary" id="save-client" type="submit">
						Guardar cliente
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Styles {
	<link rel="stylesheet" href="~/libs/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/libs/datatables/dataTables.min.js" asp-append-version="true">
	</script>
	<script src="~/js/modules/maestros/clientes/cliente.js" asp-append-version="true">
	</script>
}
