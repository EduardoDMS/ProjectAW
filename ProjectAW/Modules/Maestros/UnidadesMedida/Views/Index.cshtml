@{
	ViewData["Title"] = "Unidades de medida";
	ViewData["Description"] = "Administra las unidades usadas por los productos.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
	<div>
		<h1>
			Unidades de medida
		</h1>
		<p class="mb-0">
			Administra nombre, código y estado.
		</p>
	</div>
	<button class="btn btn-primary" id="new-unit" type="button">
		＋ Nueva unidad
	</button>
</section>

<section class="card overflow-hidden">
	<div class="table-responsive p-3">
		<table id="units-table" class="table align-middle w-100">
			<thead>
				<tr>
					<th scope="col">
						Nombre
					</th>
					<th scope="col">
						Código
					</th>
					<th scope="col">
						Estado
					</th>
					<th scope="col">
						Acciones
					</th>
				</tr>
			</thead>
			<tbody>
			</tbody>
		</table>
	</div>
	<div class="alert alert-danger m-3" id="unit-alert" role="alert" hidden>
	</div>
</section>

<div class="modal fade" id="unit-modal" tabindex="-1" aria-labelledby="unit-title" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<form id="unit-form">
				<div class="modal-header">
					<h2 class="modal-title" id="unit-title">
						Nueva unidad
					</h2>
					<button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar">
					</button>
				</div>
				<div class="modal-body">
					<div class="alert alert-danger" id="unit-form-alert" role="alert" hidden>
					</div>
					<div class="mb-3">
						<label class="form-label" for="unit-name">
							Nombre
						</label>
						<input class="form-control" id="unit-name" maxlength="100" required />
					</div>
					<div class="mb-3">
						<label class="form-label" for="unit-code">
							Código
						</label>
						<input class="form-control" id="unit-code" maxlength="10" required />
					</div>
					<div class="form-check">
						<input class="form-check-input" id="unit-active" type="checkbox" />
						<label class="form-check-label" for="unit-active">
							Activa
						</label>
					</div>
				</div>
				<div class="modal-footer">
					<button class="btn btn-light" type="button" data-bs-dismiss="modal">
						Cancelar
					</button>
					<button class="btn btn-primary" type="submit">
						Guardar
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

@section Styles {
	<link rel="stylesheet" href="~/libs/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/libs/datatables/dataTables.min.js" asp-append-version="true">
	</script>
	<script src="~/js/modules/maestros/unidades-medida/unidad-medida.js" asp-append-version="true">
	</script>
}
