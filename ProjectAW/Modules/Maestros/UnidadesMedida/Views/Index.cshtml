@{ ViewData["Title"] = "Unidades de medida"; ViewData["Description"] = "Administra las unidades usadas por los productos."; Layout = "~/Views/Shared/_Layout.cshtml"; }
<section class="page-heading"><div><h1>Unidades de medida</h1><p>Administra nombre, código y estado.</p></div><button class="btn btn-primary" id="new-unit">＋ Nueva unidad</button></section>
<section class="content-card maestro-card"><div class="table-responsive p-3"><table id="units-table" class="table align-middle w-100"><thead><tr><th>Nombre</th><th>Código</th><th>Estado</th><th>Acciones</th></tr></thead><tbody></tbody></table></div><div id="unit-alert" class="maestro-alert" role="alert" hidden></div></section>
<div class="modal fade" id="unit-modal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content maestro-modal"><form id="unit-form"><div class="modal-header"><h2 class="modal-title" id="unit-title">Nueva unidad</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="unit-form-alert" class="maestro-alert" hidden></div><label class="form-label" for="unit-name">Nombre</label><input class="form-control mb-3" id="unit-name" maxlength="100" required><label class="form-label" for="unit-code">Código</label><input class="form-control" id="unit-code" maxlength="10" required><label class="form-check mt-3"><input class="form-check-input" id="unit-active" type="checkbox"> Activa</label></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" type="submit">Guardar</button></div></form></div></div></div>
@section Styles { <link rel="stylesheet" href="~/lib/datatables/dataTables.dataTables.min.css" asp-append-version="true" /> }
@section Scripts { <script src="~/lib/datatables/dataTables.min.js" asp-append-version="true"></script><script src="~/js/modules/maestros/unidades-medida/unidad-medida.js" asp-append-version="true"></script> }
