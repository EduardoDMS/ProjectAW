@{
	ViewData["Title"] = "Proveedores";
	ViewData["Description"] = "Administra proveedores y contactos para las operaciones de entrada.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="page-heading">
	<div>
		<h1>Proveedores</h1>
		<p>Centraliza datos fiscales y personas de contacto.</p>
	</div>
	<button class="btn btn-primary" id="new-supplier" type="button">
		＋ Nuevo proveedor
	</button>
</section>
<section class="content-card maestro-card">
	<div class="maestro-toolbar">
		<label class="status-filter" for="supplier-status"
			><span>Disponibilidad</span
			><select id="supplier-status">
				<option value="">Todos</option>
				<option value="true">Activos</option>
				<option value="false">Inactivos</option>
			</select></label
		><span
			class="ms-auto"
			id="supplier-feedback"
			role="status"
			aria-live="polite"
		></span>
	</div>
	<div id="supplier-alert" class="maestro-alert" role="alert" hidden></div>
	<div class="table-responsive p-3">
		<table id="suppliers-table" class="table align-middle w-100">
			<thead>
				<tr>
					<th>Razón social</th>
					<th>Documento</th>
					<th>Contacto</th>
					<th>Correo</th>
					<th>Teléfono</th>
					<th>Estado</th>
					<th>Acciones</th>
				</tr>
			</thead>
			<tbody></tbody>
		</table>
	</div>
</section>
<div
	class="modal fade"
	id="supplier-modal"
	tabindex="-1"
	aria-labelledby="supplier-modal-title"
	aria-hidden="true"
>
	<div class="modal-dialog modal-dialog-centered modal-lg">
		<div class="modal-content maestro-modal">
			<div class="modal-header">
				<div>
					<span class="eyebrow">DIRECTORIO DE SUMINISTRO</span>
					<h2 class="modal-title" id="supplier-modal-title">
						Nuevo proveedor
					</h2>
				</div>
				<button
					class="btn-close"
					type="button"
					data-bs-dismiss="modal"
					aria-label="Cerrar"
				></button>
			</div>
			<form id="supplier-form">
				<div class="modal-body">
					<div
						id="supplier-form-alert"
						class="maestro-alert"
						role="alert"
						hidden
					></div>
					<div class="maestro-form-grid">
						<div class="maestro-field">
							<label for="supplier-business-name"
								>Razón social *</label
							><input
								class="form-control"
								id="supplier-business-name"
								name="razonSocial"
								maxlength="50"
								required
							/>
						</div>
						<div class="maestro-field">
							<label for="supplier-document-type"
								>Tipo de documento *</label
							><select
								class="form-select"
								id="supplier-document-type"
								name="idTipoDocumento"
								required
							></select>
						</div>
						<div class="maestro-field">
							<label for="supplier-document-number"
								>Número de documento *</label
							><input
								class="form-control"
								id="supplier-document-number"
								name="numeroDocumento"
								maxlength="25"
								required
							/>
						</div>
						<div class="maestro-field">
							<label for="supplier-address">Dirección</label
							><input
								class="form-control"
								id="supplier-address"
								name="direccion"
								maxlength="50"
							/>
						</div>
						<div class="maestro-field">
							<label for="supplier-contact"
								>Nombre de contacto</label
							><input
								class="form-control"
								id="supplier-contact"
								name="nombreContacto"
								maxlength="50"
							/>
						</div>
						<div class="maestro-field">
							<label for="supplier-email"
								>Correo de contacto</label
							><input
								class="form-control"
								id="supplier-email"
								name="correoContacto"
								type="email"
								maxlength="50"
							/>
						</div>
						<div class="maestro-field">
							<label for="supplier-phone"
								>Teléfono de contacto</label
							><input
								class="form-control"
								id="supplier-phone"
								name="telefonoContacto"
								maxlength="50"
							/>
						</div>
						<div class="maestro-field maestro-field--check">
							<input
								class="form-check-input"
								id="supplier-active"
								name="activo"
								type="checkbox"
							/><label for="supplier-active"
								>Proveedor activo</label
							>
						</div>
					</div>
				</div>
				<div class="modal-footer">
					<button
						class="btn btn-light"
						type="button"
						data-bs-dismiss="modal"
					>
						Cancelar</button
					><button
						class="btn btn-primary"
						id="save-supplier"
						type="submit"
					>
						Guardar proveedor
					</button>
				</div>
			</form>
		</div>
	</div>
</div>
@section Styles {
<link
	rel="stylesheet"
	href="~/lib/datatables/dataTables.dataTables.min.css"
	asp-append-version="true"
/>
}
@section Scripts {
<script
	src="~/lib/datatables/dataTables.min.js"
	asp-append-version="true"
></script>
<script
	src="~/js/modules/maestros/proveedores/proveedor.js"
	asp-append-version="true"
></script>
}


