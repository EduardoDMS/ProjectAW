@{
	ViewData["Title"] = "Usuarios";
	ViewData["Description"] = "Administra las cuentas de acceso para administración y operaciones.";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="page-heading">
	<div>
		<h1>Usuarios</h1>
		<p>Gestiona cuentas, roles y acceso de administradores y operadores.</p>
	</div>
	<button class="btn btn-primary" id="new-user" type="button">＋ Nuevo usuario</button>
</section>
<section class="content-card maestro-card">
	<div class="maestro-toolbar">
		<label class="status-filter form-label" for="user-status"><span>Estado</span><select id="user-status" class="form-select"><option value="">Todos</option><option value="true">Activos</option><option value="false">Inactivos</option></select></label>
		<span class="ms-auto" id="user-feedback" role="status" aria-live="polite"></span>
	</div>
	<div class="maestro-alert" id="user-alert" role="alert" hidden></div>
	<div class="table-responsive p-3">
		<table id="users-table" class="table align-middle w-100">
			<thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Estado</th><th>Acciones</th></tr></thead>
			<tbody></tbody>
		</table>
	</div>
</section>
<div class="modal fade" id="user-modal" tabindex="-1" aria-labelledby="user-modal-title" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content maestro-modal">
			<div class="modal-header"><div><span class="eyebrow">SEGURIDAD Y ACCESO</span><h2 class="modal-title" id="user-modal-title">Nuevo usuario</h2></div><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Cerrar"></button></div>
			<form id="user-form">
				<div class="modal-body">
					<div id="user-form-alert" class="maestro-alert" role="alert" hidden></div>
					<div class="maestro-field"><label for="user-name" class="form-label">Nombre *</label><input class="form-control" id="user-name" name="nombre" maxlength="100" autocomplete="given-name" required /></div>
					<div class="maestro-field"><label for="user-surname" class="form-label">Apellido *</label><input class="form-control" id="user-surname" name="apellido" maxlength="100" autocomplete="family-name" required /></div>
					<div class="maestro-field"><label for="user-username" class="form-label">Nombre de usuario *</label><input class="form-control" id="user-username" name="username" maxlength="20" autocomplete="username" required /></div>
					<div class="maestro-field"><label for="user-password" class="form-label">Contraseña <span id="password-required-mark">*</span></label><input class="form-control" id="user-password" name="password" type="password" autocomplete="new-password" /><small id="password-hint">Define la contraseña inicial para esta cuenta.</small></div>
					<div class="maestro-field"><label for="user-role" class="form-label">Rol *</label><select class="form-select" id="user-role" name="idRol" required><option value="">Selecciona Administrador u Operador</option></select></div>
				</div>
				<div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancelar</button><button class="btn btn-primary" id="save-user" type="submit">Crear usuario</button></div>
			</form>
		</div>
	</div>
</div>
@section Styles {
	<link rel="stylesheet" href="~/libs/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
}
@section Scripts {
	<script src="~/libs/datatables/dataTables.min.js" asp-append-version="true"></script>
	<script src="~/js/modules/seguridad/usuarios/usuario.js" asp-append-version="true"></script>
}