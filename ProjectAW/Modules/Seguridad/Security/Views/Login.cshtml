@{
	Layout = null;
	ViewData["Title"] = "Iniciar sesión";
}
<!doctype html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="theme-color" content="#004596" />
	<title>Iniciar sesión · Almacén AW</title>
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/lib/tabler-icons/dist/tabler-icons.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-page">
	<main class="auth-shell" id="login-page" data-return-url="@(ViewData["ReturnUrl"])" data-login-url="/api/auth/login">
		<section class="auth-panel" aria-labelledby="login-title">
			<div class="auth-content">
				<div class="auth-wordmark" aria-label="ProyectoAW">
					<span>Proyecto</span><strong>AW</strong>
				</div>
				<h1 id="login-title">Qué bueno tenerte de vuelta</h1>
				<p class="auth-lead">Ingresa tus credenciales para continuar al espacio de trabajo.</p>

				<div id="login-error" class="auth-alert" role="alert" aria-live="assertive" hidden></div>

				<form id="login-form" class="auth-form" novalidate>
					<div class="auth-field">
						<label for="username">Usuario</label>
						<input id="username" name="username" type="text" class="form-control" placeholder="Tu nombre de usuario" autocomplete="username" aria-describedby="username-feedback" required autofocus />
						<div class="invalid-feedback" id="username-feedback">Ingresa tu usuario.</div>
					</div>

					<div class="auth-field">
						<label for="password">Contraseña</label>
						<div class="input-group has-validation">
							<input id="password" name="password" type="password" class="form-control" placeholder="Ingresa tu contraseña" autocomplete="current-password" aria-describedby="password-feedback" required />
							<button class="btn password-toggle" type="button" id="toggle-password" aria-controls="password" aria-label="Mostrar contraseña" aria-pressed="false"><i class="ti ti-eye" aria-hidden="true"></i></button>
							<div class="invalid-feedback" id="password-feedback">Ingresa tu contraseña.</div>
						</div>
					</div>

					<button id="login-submit" class="btn btn-primary auth-submit" type="submit">
						<span class="button-label">Iniciar sesión</span>
						<span class="button-spinner" aria-hidden="true"></span>
						<i class="ti ti-arrow-right button-arrow" aria-hidden="true"></i>
					</button>
				</form>
			</div>
			<footer class="auth-copyright">© @DateTime.Now.Year Proyecto AW</footer>
		</section>

		<aside class="auth-aside" aria-label="Información del sistema">
			<div class="aside-orbit aside-orbit--one"></div>
			<div class="aside-orbit aside-orbit--two"></div>
			<div class="aside-content">
				<h2>Cada movimiento,<br /><em>bajo control.</em></h2>
				<p>Desde la recepción hasta el despacho, gestiona tu almacén con visibilidad, orden y precisión.</p>

				<img class="img-fluid aside-illustration" src="~/content/imagenes/andronium-flujo.png" alt="Ilustración del flujo entre almacén, recepción y despacho" />
			</div>
		</aside>
	</main>
	<script src="~/js/modules/seguridad/auth/auth.js" asp-append-version="true"></script>
</body>
</html>
