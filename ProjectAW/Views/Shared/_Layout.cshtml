<!DOCTYPE html>
<html lang="es">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="theme-color" content="#004596" />
	<title>@ViewData["Title"] · Almacén AW</title>
	<link rel="stylesheet" href="~/libs/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/libs/tabler-icons/dist/tabler-icons.min.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/libs/sweetalert2/sweetalert2.min.css" asp-append-version="true" />
	@await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-body">
	<div class="app-shell">
		<aside class="app-sidebar" id="appSidebar" aria-label="Menú principal">
			<a class="sidebar-brand" asp-controller="Home" asp-action="Index" title="Almacén AW">
				<span class="brand-mark" aria-hidden="true"><i class="ti ti-building-warehouse"></i></span>
				<span class="sidebar-brand__copy"><strong>Almacén AW</strong><small>Gestión de inventario</small></span>
				<span class="sidebar-brand__shrink" aria-hidden="true">AW</span>
			</a>

			<div class="sidebar-scroll">
				<span class="sidebar-section-label">ESPACIO DE TRABAJO</span>
				<a class="sidebar-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "is-active" : "")" asp-controller="Home" asp-action="Index" title="Inicio">
					<i class="ti ti-home" aria-hidden="true"></i><span>Inicio</span>
				</a>

				<div class="sidebar-section-label sidebar-section-label--spaced">OPERACIONES</div>
				<button class="sidebar-group-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() == "Guia" ? "is-current-group" : "")" type="button" data-sidebar-group aria-expanded="true" aria-controls="guides-menu" title="Guías">
					<i class="ti ti-file-text" aria-hidden="true"></i>
					<span>Guías</span><i class="ti ti-chevron-down sidebar-chevron" aria-hidden="true"></i>
				</button>
				<nav class="sidebar-submenu is-open" id="guides-menu" aria-label="Guías">
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" && ViewContext.RouteData.Values["controller"]?.ToString() == "Guia" ? "is-active" : "")" asp-controller="Guia" asp-action="Index" title="Listado de guías"><span class="sidebar-link__bullet"></span><span>Listado de guías</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["action"]?.ToString() == "Motivos" && ViewContext.RouteData.Values["controller"]?.ToString() == "Guia" ? "is-active" : "")" asp-controller="Guia" asp-action="Motivos" title="Motivos de guía"><span class="sidebar-link__bullet"></span><span>Motivos de guía</span></a>
@*                     <a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["action"]?.ToString() == "Nueva" && ViewContext.RouteData.Values["controller"]?.ToString() == "Guia" ? "is-active" : "")" asp-controller="Guia" asp-action="Nueva" title="Registrar guía"><span class="sidebar-link__bullet"></span><span>Registrar guía</span></a> *@
				</nav>

				<button class="sidebar-group-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() is "Stock" or "Movimientos" ? "is-current-group" : "")" type="button" data-sidebar-group aria-expanded="false" aria-controls="stocks-menu" title="Stocks">
					<i class="ti ti-packages" aria-hidden="true"></i>
					<span>Stocks</span><i class="ti ti-chevron-down sidebar-chevron" aria-hidden="true"></i>
				</button>
				<nav class="sidebar-submenu" id="stocks-menu" aria-label="Stocks">
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" ? "is-active" : "")" asp-controller="Stock" asp-action="Index" title="Existencias"><span class="sidebar-link__bullet"></span><span>Existencias</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Movimientos" ? "is-active" : "")" asp-controller="Movimientos" asp-action="Index" title="Movimientos"><span class="sidebar-link__bullet"></span><span>Movimientos</span></a>
				</nav>

				<div class="sidebar-section-label sidebar-section-label--spaced">GESTIÓN</div>
				<button class="sidebar-group-toggle @(ViewContext.RouteData.Values["controller"]?.ToString() is "Usuario" or "Rol" ? "is-current-group" : "")" type="button" data-sidebar-group aria-expanded="false" aria-controls="maintenance-menu" title="Gestion de Recursos">
					<i class="ti ti-adjustments-horizontal" aria-hidden="true"></i>
					<span>Gestion de Recursos</span><i class="ti ti-chevron-down sidebar-chevron" aria-hidden="true"></i>
				</button>
				<nav class="sidebar-submenu" id="maintenance-menu" aria-label="Gestion de Recursos">
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuario" ? "is-active" : "")" asp-controller="Usuario" asp-action="Index" title="Usuarios"><span class="sidebar-link__bullet"></span><span>Usuarios</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Producto" ? "is-active" : "")" asp-controller="Producto" asp-action="Index" title="Productos"><span class="sidebar-link__bullet"></span><span>Productos</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Almacen" ? "is-active" : "")" asp-controller="Almacen" asp-action="Index" title="Almacenes"><span class="sidebar-link__bullet"></span><span>Almacenes</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ubicacion" ? "is-active" : "")" asp-controller="Ubicacion" asp-action="Index" title="Ubicaciones"><span class="sidebar-link__bullet"></span><span>Ubicaciones</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Categoria" ? "is-active" : "")" asp-controller="Categoria" asp-action="Index" title="Categorías"><span class="sidebar-link__bullet"></span><span>Categorías</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cliente" ? "is-active" : "")" asp-controller="Cliente" asp-action="Index" title="Clientes"><span class="sidebar-link__bullet"></span><span>Clientes</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedor" ? "is-active" : "")" asp-controller="Proveedor" asp-action="Index" title="Proveedores"><span class="sidebar-link__bullet"></span><span>Proveedores</span></a>
					<a class="sidebar-link sidebar-link--child @(ViewContext.RouteData.Values["controller"]?.ToString() == "UnidadMedida" ? "is-active" : "")" asp-controller="UnidadMedida" asp-action="Index" title="Unidades de medida"><span class="sidebar-link__bullet"></span><span>Unidades de medida</span></a>
				</nav>
			</div>

			<div class="sidebar-bottom"><span class="sidebar-bottom__line"></span><span>© @DateTime.Now.Year Almacén AW</span></div>
		</aside>

		<button class="sidebar-overlay" type="button" data-sidebar-close aria-label="Cerrar menú"></button>

		<div class="app-workspace">
			<header class="app-header">
				<div class="app-header__left">
					<button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="appSidebar" aria-expanded="true" aria-label="Contraer menú lateral" title="Contraer o expandir menú">
						<span></span><span></span><span></span>
					</button>
				</div>
				@* <div class="app-header__left">
					<button class="sidebar-toggle" type="button" data-sidebar-toggle aria-controls="appSidebar" aria-expanded="true" aria-label="Contraer menú lateral" title="Contraer o expandir menú">
						<span></span><span></span><span></span>
					</button>
					<div class="header-location"><span>Almacén AW</span><b aria-hidden="true">/</b><strong>@ViewData["Title"]</strong></div>
				</div> *@
				<div class="app-account">
					<p class="account-feedback" id="logout-feedback" role="alert" hidden></p>
					<div class="account-identity">
						<span class="account-avatar" aria-hidden="true">@((User.Identity?.Name ?? "U")[0].ToString().ToUpperInvariant())</span>
						<span class="account-copy"><strong>@(User.Identity?.Name ?? "Usuario")</strong><small>Sesión activa</small></span>
					</div>
					<span class="account-divider" aria-hidden="true"></span>
					<button class="btn btn-logout" type="button" data-auth-logout aria-label="Cerrar sesión">
						<i class="ti ti-logout" aria-hidden="true"></i><span>Salir</span>
					</button>
				</div>
			</header>

			<main class="app-main">
				<div class="container-fluid app-container">@RenderBody()</div>
			</main>
		</div>
	</div>

	<script src="~/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/libs/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/modules/seguridad/auth/auth.js" asp-append-version="true"></script>
	<script src="~/js/modules/layout/sidebar.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
